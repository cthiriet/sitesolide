# Dependencies
node_modules/

# macOS
.DS_Store

# Logs and temporary files
*.log
*.tmp

# Environment variables
.env
.env.local

# What earlier versions kept on the workstation and nothing reads any more: a
# copy of every secret, the registry saying where each landed, and a copy of
# every generated unit and block. A clone that still has them keeps them out of
# git until they are deleted. See docs/secrets.md.
secrets/

# Audience measurement: its database and the directory its tests rewrite. The
# data directory carries the database on the VM, never here.
analytics/data/
analytics/.test-data/
analytics/node_modules/

# The door page of the previews, generated by portal/scripts/lock-page.ts
# just before being placed: its footer carries the contact address of the
# installation, which this repository does not know.
infra/verrous/verrou.html

# Terraform's values and state live in ~/.config/sitesolide/terraform/, see
# bin/terraform.sh. These lines stay as a second guard, should a file land here
# again by an old habit: each would carry a token or the machine's address.
infra/terraform.tfstate
infra/terraform.tfstate.*
infra/*.tfvars
infra/caddy-cloudflare.env

# Fixtures of the end-to-end tests: what their build produces, and the fake
# node_modules that the refusals test creates itself. Versioning it would turn
# that test green wrongly after a clone, the node_modules rule swallowing it.
bin/tests/e2e/projects/static-docs/dist/
bin/tests/e2e/projects/bun-mixed/public/
bin/tests/e2e/rejects/public-empty/public/

# Dashboard: its sessions database and the directory its tests rewrite at each
# pass. The data directory carries the snapshot on the VM, never here, and the
# database contains nothing but sessions.
dashboard/data/
dashboard/.test-data/

# Copies made by dashboard/scripts/borrow.ts before each build: they are
# artefacts, their source lives in api/ and bin/.
dashboard/borrowed/

# public/ is from now on generated by the Astro build of dashboard/web: its
# source is web/src, and versioning it would make two states diverge.
dashboard/public/
dashboard/web/.astro/

# Portal: its signing key in local, the directory its tests rewrite, and the
# copies made by portal/scripts/borrow.ts before each build.
portal/data/
portal/.essais/
portal/borrowed/

# The portal's test databases, rewritten at every `bun test`.
.attempts/
