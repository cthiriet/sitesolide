---
import Layout from "@/layouts/main.astro"
import { Application } from "@/components/application"
---

<Layout title="sitesolide">
  <!--
    An address from before a site's one Access section, kept so that bookmarks keep
    working: the island reads it as its equivalent, then replaces the address
    with the new one (lib/pages.ts, redirect).
  -->
  <Application client:load path="/site/sharing/" />
</Layout>
