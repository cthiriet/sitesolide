{
  "slug": "portal",
  "description": "Sign-in portal in front of the protected sites",
  "port": 3026,
  "publicDir": "public",
  "build": "bun scripts/borrow.ts",
  "start": "/usr/local/bin/bun run server.ts",
  "routes": [
    "/sante",
    "/oidc/start",
    "/oidc/callback",
    "/oidc/signout"
  ],
  "env": {
    "NODE_ENV": "production",
    "SITESOLIDE_CONTACT": "{contact}",
    "PUBLIC_URL": "https://{slug}.{zone}"
  },
  "network": "outbound",
  "exclude": [
    "node_modules",
    "data",
    "tests",
    "scripts",
    ".attempts"
  ],
  "memory": "128M",
  "headers": {
    "X-Robots-Tag": "noindex, nofollow, noarchive"
  },
  "secrets": [
    "portal.env"
  ]
}
