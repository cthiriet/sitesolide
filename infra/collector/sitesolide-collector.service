# Snapshot of the state of the machine for the dashboard.
#
# It is the only privileged component of the dashboard, and its reason for being
# fits in two lines: the unit generated for a project forbids it from reading
# the other sites, and /etc/caddy/locks-codes.json is in 0600 for the deployment
# account, which no mount gets around. The web service therefore has none of
# these rights: it reads only the file placed here, in its own data directory.
#
# Placed by bin/deploy-collector.sh. The snapshot script, for its part, travels
# with the code of the dashboard and updates itself by an ordinary
# `sitesolide deploy`.

[Unit]
Description=Machine state snapshot for the dashboard
# Nothing to record as long as the dashboard has not been deployed once.
ConditionPathExists=/srv/sites/dashboard/app/collector.ts

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/bun run /srv/sites/dashboard/app/collector.ts

# The zone, which the collector needs to name each site's address and to build
# the host allowlist it hands to analytics. It has no default: a ready-made
# value here would name the machine of whoever wrote the file. The same file
# Caddy is given, so the two can never disagree on what zone is served.
EnvironmentFile=/etc/caddy/sitesolide.env

# This snapshot runs every minute and walks through every directory served. It
# must never dispute the disk with a site in the middle of answering a visitor.
Nice=10
IOSchedulingClass=idle

# A snapshot that drags on is a failed snapshot: the next one arrives in one
# minute, and two collectors at once have nothing to bring each other.
TimeoutStartSec=45

# Confinement of what runs as root. It reads /srv and /etc/caddy, and writes
# only into two data directories.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ReadWritePaths=/srv/sites/dashboard/data

# The table of hosts placed at analytics, host to directory served.
#
# It is the only write of this collector outside the directory of the dashboard,
# and it is here rather than at the steward because it carries no secret: this
# correspondence is already read in the Caddyfile and in the DNS. The analytics
# service, for its part, cannot build it, its unit hiding from it the other
# directories of /srv as well as /etc/caddy, and without it it refuses any
# measurement.
#
# The directory may not exist: analytics is not necessarily deployed, and
# systemd does not fail the unit for a missing ReadWritePaths when it is
# prefixed with a dash.
ReadWritePaths=-/srv/sites/analytics/data

# ProtectSystem=full and not strict, on purpose. Strict would mount /run
# read-only, and this script talks to systemd through a socket that lives there;
# the doubt can only be lifted on the machine that serves the clients, and
# nothing is tried out on it. What would be gained is thin: /var and /run have
# nothing this snapshot wants.
# Lifted since, outside production: systemctl passes under strict, measured on
# the bench.
ProtectSystem=full

# Everything it reads is on this machine.
IPAddressDeny=any
IPAddressAllow=localhost

ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryMax=192M
