# The monitor: one pass over the machine, every minute, by its timer. See
# monitor/README.md for what it checks and how it alerts.
#
# It is the only component of the platform that watches the others, and it
# holds no privilege at all: everything it reads is open to any account. The
# unit makes that a guarantee rather than a habit. A compromised monitor holds
# what any account on the machine already holds, plus its two alerting
# addresses.
#
# Placed by bin/deploy-monitor.sh, never by `sitesolide deploy`, like the
# steward: the code is built into one file and installed root:root under
# /usr/local/lib/sitesolide/, so the account that runs it cannot rewrite it.

[Unit]
Description=Monitor: Caddy, the sites over HTTPS, units, disk, memory, certificates and backups
# Nothing to watch until the code is there; a missing file must not pass for a
# failed check.
ConditionPathExists=/usr/local/lib/sitesolide/monitor.js

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bun /usr/local/lib/sitesolide/monitor.js

# A static system account of its own, sitesolide-monitor, with its own group,
# no home and no login shell, made by bin/deploy-monitor.sh before this file
# is installed. No other unit runs as it, and it owns nothing outside its state
# directory.
#
# NOT DynamicUser=yes, which this unit used to be: systemctl reads the units
# over the D-Bus system bus, and dbus-daemon runs with
# SYSTEMD_NSS_DYNAMIC_BYPASS=1, so it cannot resolve a dynamic uid. Every
# reading failed with "Transport endpoint is not connected", and the monitor
# checked no unit, Caddy included, on any pass. Measured on Debian 13, systemd
# 257 and dbus-daemon 1.16.2: `systemd-run --wait --pipe -p DynamicUser=yes
# /usr/bin/systemctl show caddy` fails where `-p User=nobody` answers, although
# systemd.exec says DynamicUser does not affect calling into other services.
User=sitesolide-monitor
Group=sitesolide-monitor
# DynamicUser implied it, and no other line lays it: no IPC object of the
# account's outlives a run. What else it implied, ProtectSystem=strict,
# ProtectHome, PrivateTmp, NoNewPrivileges and RestrictSUIDSGID, is laid
# below already.
RemoveIPC=yes

# /var/lib/sitesolide-monitor: the memory of the previous runs and the status
# the dashboard's collector copies, a directory of the account's, 0700. The
# collector runs as root, opens status.json without following a link, and
# copies it only if it belongs to this directory's owner. UMask=0077: what it
# writes belongs to it alone, the collector reading as root regardless.
#
# A machine that ran the DynamicUser unit keeps it in
# /var/lib/private/sitesolide-monitor, behind a link: systemd moves it back up
# at this unit's first start, state.json with it. bin/deploy-monitor.sh hands
# it to the account beforehand: systemd 257 does not chown a directory that
# belongs to the nobody user, which is how the DynamicUser unit left it, but
# ID-maps it, and on the host it would stay nobody's (monitor/README.md,
# "Upgrading from the dynamic account").
StateDirectory=sitesolide-monitor
StateDirectoryMode=0700
UMask=0077

# The zone, which names every host to probe. The file Caddy is given, so the
# two can never disagree on what is served. Without it the run stops and says
# so, and the heartbeat's silence reports it.
EnvironmentFile=/etc/caddy/sitesolide.env

# The alerting addresses, HEARTBEAT_URL, ALERT_WEBHOOK_URL and
# ALERT_WEBHOOK_FORMAT, set from the dashboard's Secrets, file
# dashboard-monitor.env of the dashboard site, root:root 0600. PID 1 reads it
# as root before it drops to the account, so the account never can. The dash:
# with no file, the monitor runs all the same and writes to the journal only.
#
# InaccessiblePaths=/etc/sitesolide is NOT laid, although the monitor never
# opens that directory: whether systemd still hands over an EnvironmentFile
# from a directory the namespace hides is measured on arm64 only, and the units
# generated for projects follow the same rule until it is on x86_64
# (bin/cli/unit.ts). The account cannot read the 0600 files there anyway; it
# can list their names, which the monitor does not do.
EnvironmentFile=-/etc/sitesolide/dashboard-monitor.env

# A run takes a few seconds; the probes stop at 25 whatever happens, and the
# heartbeat must leave before this kills the run. The timer starts no second
# run while one is still going.
TimeoutStartSec=50s

# The monitor must never dispute the machine with a site answering a visitor.
Nice=10
IOSchedulingClass=idle
MemoryMax=128M

# No capability at all, none to gain.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# What it reads: /srv/sites by name, /etc/caddy/domaines.map, /proc/meminfo,
# statfs, the backup status. All read-only under ProtectSystem=strict.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Other processes invisible. ProcSubset=pid is NOT laid: it would hide
# /proc/meminfo, which the memory check reads.
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# @system-service and nothing stricter, the steward's measurement: a narrower
# set kills Bun at start. MemoryDenyWriteExecute stays out for the JIT.
SystemCallFilter=@system-service

# The network, and only the families it needs: AF_UNIX for systemctl over
# D-Bus, AF_INET and AF_INET6 for the probes on the loopback's 443 and for the
# heartbeat and the webhook, outside. No address filter: the outside services
# have no fixed address. The loopback rule (bin/cli/loopback.ts) closes the
# services' ports and Caddy's admin API to this account all the same.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
