# A restore: puts one project's data back as a snapshot had it, one restore
# per start. See dashboard/src/backup/restore.ts and README.md beside it.
#
#   systemctl start --no-block sitesolide-restore@cms.service   (the steward only)
#   cat /run/sitesolide-backup/restore/cms.json
#
# Only the steward launches it, after the dashboard asked with an unlocked
# session and the slug retyped; the snapshot rides in a request file the
# steward writes and this unit consumes. It never activates by itself: no
# [Install], no timer.
#
# One template, the folder alone as the instance, like the gatekeeper: the
# unit writes only into /srv/sites/%i, and a compromised restore holds the one
# project it was named for. `%i` and not `%I`: the unescaped form would turn
# the dashes of a slug into slashes.
#
# Placed by bin/deploy-backup.sh, never by `sitesolide deploy`.
#
# NEVER `caddy stop` nor `caddy start`: a restore changes a data folder and
# restarts that project's services, nothing else.

[Unit]
Description=Restore of the data of %i
RequiresMountsFor=/srv/sites /var/backups

[Service]
Type=oneshot
# `%n`: the full name, from which the restore draws the folder.
ExecStart=/usr/local/bin/bun /usr/local/lib/sitesolide/backup.js restore %n
# Once the restore's process is gone, however it went: a restore cut short
# with the project's services stopped, by the timeout below or by anything
# else, left a mark; this repairs what is certain and starts them again
# (afterRestore in restore.ts). After a restore that finished, it does nothing.
ExecStopPost=/usr/local/bin/bun /usr/local/lib/sitesolide/backup.js after-restore %n
EnvironmentFile=/etc/caddy/sitesolide.env
# The bucket's settings, and the disk reserve: a snapshot only the bucket
# still holds is fetched by a download child, which PID 1 hands this same
# file by name (dashboard/src/backup/runner.ts).
EnvironmentFile=-/etc/sitesolide/dashboard-backup.env

# The steward does not wait: it starts this unit with --no-block and the page
# follows the result file. The longest restore waits ten minutes for a run to
# finish, measures the data (ten at most), downloads from the bucket (twenty),
# extracts (twenty), saves the current data (twenty) and watches the service
# (ten with a rollback): ninety minutes, RESTORE_TIMEOUT_MS in restore.ts. It
# stops nothing without the time for what follows; killed all the same, the
# ExecStopPost above starts the services again, and the next restore repairs
# or refuses the folders left (recovery.ts).
TimeoutStartSec=90min
# The killed process's exit, then the ExecStopPost: a few systemctl calls.
TimeoutStopSec=3min

UMask=0077
StateDirectory=sitesolide-backup
StateDirectoryMode=0755
RuntimeDirectory=sitesolide-backup
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Two capabilities, for its sole job:
#
# CAP_DAC_OVERRIDE: /srv/sites/<slug> belongs to the deployment account, and
# swapping the data folder renames inside it; the previous data, owned by
# site-<slug> in 0700 folders, is removed once the service runs again.
#
# CAP_CHOWN: the folder the snapshot is extracted into is given to the
# project's account before the extraction, which runs as that account. The
# mode is set before, while root still owns it: no CAP_FOWNER.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN

# Writing: the folder of the project named, and the archives (the snapshot of
# the current data taken before replacing it). Its code and its public files
# stay out of reach, like for the gatekeeper.
ProtectSystem=strict
ReadWritePaths=/srv/sites/%i /var/backups/sitesolide
ReadOnlyPaths=-/srv/sites/%i/app -/srv/sites/%i/public
# The steward's state and every project's secrets: nothing here needs them,
# and CAP_DAC_OVERRIDE would make them readable. The bucket's settings still
# arrive: PID 1 reads EnvironmentFile= before the walls go up (systemd.exec(5)).
InaccessiblePaths=-/var/lib/sitesolide-steward -/etc/sitesolide
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true

# No network at all: root with CAP_DAC_OVERRIDE talks to systemd alone, over
# AF_UNIX. A snapshot only the bucket holds is fetched by a download child,
# a dynamic user with the network and no right on any project
# (dashboard/src/backup/runner.ts).
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

MemoryMax=256M
