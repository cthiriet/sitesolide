# The backup component's scheduled run: every project's data folder
# snapshotted into the server's restic repository, the old snapshots
# forgotten, the bucket's repository brought up to date if one is configured,
# once a day a prune and a check, and /var/lib/sitesolide-backup/last-run.json
# written for the monitor. See dashboard/src/backup/README.md.
#
#   systemctl start sitesolide-backup.service        a run now, waits for its end
#   cat /var/lib/sitesolide-backup/last-run.json
#
# It runs as root to list the projects and to write a repository no project
# can read; it never opens a project's file itself. The copy of each data
# folder runs as that project's account, in a transient unit that PID 1
# creates on request (`systemd-run`, dashboard/src/backup/runner.ts), started
# by restic itself, and confined like the project's own service: what follows
# bounds the orchestrator and restic, its child.
#
# Placed by bin/deploy-backup.sh, never by `sitesolide deploy`, and launched by
# sitesolide-backup.timer once `bin/deploy-backup.sh enable` has been run.
#
# NEVER `caddy stop` nor `caddy start`: nothing here touches Caddy.

[Unit]
Description=Snapshots of every project's data
# It reads /srv/sites and writes /var/backups: nothing to do before they are mounted.
RequiresMountsFor=/srv/sites /var/backups
# Installed, the timer may fire before the code is there: nothing then.
ConditionPathExists=/usr/local/lib/sitesolide/backup.js

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bun /usr/local/lib/sitesolide/backup.js run
# The zone names the landing's folder in /srv/sites; without it the landing
# would not be recognised as a project, and its data would not be saved.
EnvironmentFile=/etc/caddy/sitesolide.env
# The bucket and the passphrase of its repository, managed from the dashboard's
# Secrets section, under the dashboard site. Absent: local snapshots only.
# Read by PID 1 as root before the process starts: the file stays root's,
# 0600, and is re-read at every run, so a change applies at the next one.
EnvironmentFile=-/etc/sitesolide/dashboard-backup.env

# A run must never dispute the disk or the processor with a site answering a
# visitor; the copies it starts get the same treatment from runner.ts.
Nice=10
IOSchedulingClass=idle

# Under the hour of the timer. No copy starts after 25 minutes, and each is
# given its share of what is left of those 25, 20 minutes at most; no copy to
# the bucket starts after 40, and every call to the bucket is stopped at 45
# (dashboard/src/backup/run.ts), so that the status file is always written
# before systemd would kill the run.
TimeoutStartSec=50min

UMask=0077
# /var/lib/sitesolide-backup: the database, the status file (0644, for the
# monitor), the restore requests (0700). 0755 so that the monitor need not
# be root to read the status; everything sensitive inside is 0600 or 0700.
StateDirectory=sitesolide-backup
StateDirectoryMode=0755
# /run/sitesolide-backup: the lock shared with the restores, and their
# results. Kept after the unit stops, the restores' results are read there.
RuntimeDirectory=sitesolide-backup
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# One capability: reading the projects' folders to list them and measure
# them, never to write there. Everything it writes is in its own folders,
# which root owns. Starting a transient unit needs none: PID 1 judges the
# caller by its uid on its socket.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH

# The whole system read-only except the repository, and the archives of the
# format before restic, which the run imports and then removes. Both are
# created 0700 root by bin/deploy-backup.sh: missing, the unit would fail
# with 226/NAMESPACE. The repository's key beside them is read, never written.
ProtectSystem=strict
ReadWritePaths=/var/backups/sitesolide-restic /var/backups/sitesolide
# restic's cache and temporary packs, on disk: a private /tmp on a tmpfs
# would be charged to this unit's memory.
CacheDirectory=sitesolide-restic
CacheDirectoryMode=0700
# Every project's secrets, and the steward's state: CAP_DAC_READ_SEARCH would
# read them, and nothing here needs them. The bucket's settings above still
# arrive: PID 1 reads EnvironmentFile= on its own side, "before any file
# system changes like bind mounts take place" (systemd.exec(5)).
InaccessiblePaths=-/etc/sitesolide -/var/lib/sitesolide-steward
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true

# The network, for the bucket only: the copies themselves have none at all,
# and restic is handed the bucket's credentials only for the calls to it.
# AF_UNIX for systemd, which systemd-run reaches through its socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# Like the steward and the gatekeeper: @system-service, nothing stricter
# (Bun dies with status=31/SYS under `~@privileged @resources`).
SystemCallFilter=@system-service

# Bun, and one restic at a time beside it: measured on two CPUs with Debian's
# 0.18.0, 57 MiB for a listing up to 174 MiB for a copy to the bucket. restic
# runs with GOMAXPROCS=2 and GOMEMLIMIT, and through choom, the first process
# the kernel kills if this ceiling is reached: with OOMPolicy=continue, the
# run goes on without it, that step failed and said so, and writes the status.
MemoryMax=512M
OOMPolicy=continue
