# A project turned off, turned on, or removed on the machine, one action per
# start. See dashboard/src/installer/lifecycle.ts and bin/cli/lifecycle.ts.
#
#   systemctl start sitesolide-lifecycle@blog.service
#   cat /run/sitesolide-installer/lifecycle-blog.json
#
# One template, the slug alone as the instance, the action in the request the
# steward writes first, /var/lib/sitesolide-steward/lifecycle/<slug>.json.
# Only the steward starts it, for the owner, from the dashboard or from
# `sitesolide disable` and `sitesolide enable` over SSH. It never activates by
# itself: no [Install], no timer. Started by hand without a fresh request, it
# does nothing.
#
# The same installer.js and the same walls as sitesolide-rename@.service:
# stopping, disabling and starting a project's units, laying its block or the
# block of a site turned off, removing its folder, store and account
# (userdel) are each root on the machine. It runs no code of the project's.
#
# NEVER `caddy stop` nor `caddy start` in what it launches: only
# `systemctl reload caddy` applies a configuration (CLAUDE.md, Production).
#
# Placed by bin/deploy-installer.sh, never by `sitesolide deploy`.

[Unit]
Description=Turning off, on or removing %i
RequiresMountsFor=/srv/sites /etc/caddy

[Service]
Type=oneshot
# The served zone, which the unit and block generators write and the probes
# need: the same file Caddy is given.
EnvironmentFile=/etc/caddy/sitesolide.env
EnvironmentFile=/etc/sitesolide-installer.env
ExecStart=/usr/local/bin/bun /usr/local/lib/sitesolide/installer.js --lifecycle %n

# Stopping the services, a validation, a reload, the services
# started and every site probed, a first certificate under manual DNS
# included, then the same way back: ten minutes bound the worst. The steward
# waits on it.
TimeoutStartSec=10min
TimeoutStopSec=30s

# The result, beside the installer's: the steward reads it there.
RuntimeDirectory=sitesolide-installer
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022

# CAP_CHOWN and CAP_FOWNER: the manifest keeps its owner and mode when it is
# rewritten. CAP_DAC_OVERRIDE: /srv/sites/<slug> belongs to the deployment
# account, and the stores to root in 0700 folders. CAP_DAC_READ_SEARCH: the
# project's folders are read across accounts. CAP_AUDIT_WRITE: userdel
# reports to the audit subsystem. systemctl asks for none.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_AUDIT_WRITE

# Writing: the sites, /etc (userdel rewrites passwd, group,
# shadow and gshadow by renaming in /etc itself; the units and their
# drop-ins; /etc/caddy/sites and the domain table), the gatekeeper's folder,
# where the Caddy lock and the backup of the slug live, and the projects'
# stores and their previous versions, removed with the project.
ProtectSystem=strict
ReadWritePaths=/srv/sites /etc /run/sitesolide-gatekeeper -/var/log/lastlog -/var/log/faillog
ReadOnlyPaths=/etc/sitesolide
ReadWritePaths=-/etc/sitesolide/projects -/var/lib/sitesolide-steward/precedents/projects
# The backups' lock, which a backup run and a restore take: the run waits
# for it, and never moves or deletes a folder either is copying or swapping.
# Laid first, with the backup units' own mode, when none has run since boot.
ReadWritePaths=/run/sitesolide-backup
ExecStartPre=+/usr/bin/install -d -m 0755 /run/sitesolide-backup
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true

# The loopback alone, for the probes towards 127.0.0.1:443.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

MemoryMax=256M
